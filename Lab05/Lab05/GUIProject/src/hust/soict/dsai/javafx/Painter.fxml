<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="480.0" prefWidth="640.0"
            xmlns="http://javafx.com/javafx/11.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="hust.soict.dsai.javafx.PainterController">
    <padding><Insets bottom="8.0" left="8.0" right="8.0" top="8.0"/></padding>

    <!-- LEFT: VBox with tools and clear button -->
    <left>
        <VBox fx:id="drawingAreaPane" spacing="8.0" maxHeight="1.7976931348623157E308">
            <BorderPane.margin><Insets right="8.0"/></BorderPane.margin>

            <TitledPane text="Tools" expanded="true">
                <VBox spacing="4.0">
                    <RadioButton fx:id="radioBtnPen" text="Pen" selected="true">
                        <toggleGroup>
                            <ToggleGroup fx:id="toolGroup"/>
                        </toggleGroup>
                    </RadioButton>
                    <RadioButton fx:id="radioBtnEraser" text="Eraser" toggleGroup="$toolGroup"/>
                </VBox>
            </TitledPane>

            <Button text="Clear" maxWidth="1.7976931348623157E308" onAction="#clearButtonPressed"/>
        </VBox>
    </left>

    <!-- CENTER: Pane for drawing -->
    <center>
        <Pane fx:id="drawingPane"
              style="-fx-background-color: white;"
              onMouseDragged="#drawingAreaMouseDragged"/>
    </center>
</BorderPane>
